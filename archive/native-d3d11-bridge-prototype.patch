+        D3D12_RESOURCE_BARRIER after[]={transition(shared[i],sharedState,D3D12_RESOURCE_STATE_COMMON),
+            transition(targets[i],targetState,states[i])};list->ResourceBarrier(2,after);
+    }
+    if(FAILED(list->Close()))return false;
+    ID3D12CommandList* lists[]={list};r->queue->ExecuteCommandLists(1,lists);
