+    ID3D12Resource* targets[]={r->colorTarget,r->depthTarget};
+    D3D12_RESOURCE_STATES states[]={D3D12_RESOURCE_STATE_RENDER_TARGET,D3D12_RESOURCE_STATE_DEPTH_WRITE};
+    for(UINT i=0;i<2;i++){
+        auto sharedState=importing?D3D12_RESOURCE_STATE_COPY_SOURCE:D3D12_RESOURCE_STATE_COPY_DEST;
+        auto targetState=importing?D3D12_RESOURCE_STATE_COPY_DEST:D3D12_RESOURCE_STATE_COPY_SOURCE;
+        D3D12_RESOURCE_BARRIER before[]={transition(shared[i],D3D12_RESOURCE_STATE_COMMON,sharedState),
+            transition(targets[i],states[i],targetState)};list->ResourceBarrier(2,before);
